#: src/Form/ConfigForm.php:250
msgid "Light from every side. Used only when Lights is Custom."
msgstr "Luz desde todos los lados. Solo se usa cuando Luces es Personalizadas."

#: src/Form/ConfigForm.php:258
msgid "Ambient light strength"
msgstr "Intensidad de la luz ambiental"

#: src/Form/ConfigForm.php:267
msgid "Number of lights"
msgstr "Número de luces"

#: src/Form/ConfigForm.php:268
msgid "Lights above this number keep their settings but are not used."
msgstr ""
"Las luces por encima de este número conservan sus ajustes, pero no se usan."

#: src/Form/ConfigForm.php:284
msgid "model-viewer environment"
