msgstr "La sombra bajo los modelos GLB/glTF. Con 0 no se muestra."

#: src/Form/ConfigForm.php:318
msgid "model-viewer shadow softness"
msgstr "Suavidad de la sombra de model-viewer"

#: src/Form/ConfigForm.php:349
msgid ""
"0 is from the viewer’s side of the model, 90 from the right, 180 from behind."
msgstr ""
"0 es desde el lado del modelo que ve el espectador, 90 desde la derecha, 180 "
"desde detrás."

#: src/Form/ConfigForm.php:359
msgid "0 is level with the model, 90 is overhead."
msgstr "0 es a la altura del modelo, 90 es desde arriba."

