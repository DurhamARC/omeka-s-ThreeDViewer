#: src/Form/ConfigForm.php:226
msgid "Brightness"
msgstr "Brillo"

#: src/Form/ConfigForm.php:227
msgid "Multiplies the strength of every light. 1 leaves the lighting as it is."
msgstr ""
"Multiplica la intensidad de todas las luces. Con 1, la iluminación no cambia."

#: src/Form/ConfigForm.php:236
msgid "Lights"
msgstr "Luces"

#: src/Form/ConfigForm.php:237
msgid "Custom builds the lights below in every viewer, in place of their own."
