msgstr "Predeterminado de model-viewer"

#: src/Form/ConfigForm.php:288
msgid "Neutral"
msgstr "Neutro"

#: src/Form/ConfigForm.php:289
msgid "Legacy"
msgstr "Clásico"

#: src/Form/ConfigForm.php:290
